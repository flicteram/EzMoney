{
  "name": "Ez Money",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json", "**/.package-lock.json"],
  "tree": {
    "$className": "DataModel",

    "ServerScriptService": {
      "TS": {
        "$path": "out/server"
      }
    },

    "ReplicatedStorage": {
      "rbxts_include": {
        "$path": "include",
        "node_modules": {
          "$className": "Folder",
          "@rbxts": {
            "$path": "node_modules/@rbxts"
          },
          "@rbxts-js": {
            "$path": "node_modules/@rbxts-js"
          }
        }
      },
      "TS": {
        "$path": "out/shared"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "TS": {
          "$path": "out/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Technology": "Future"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
