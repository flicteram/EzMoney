# Normalize line endings: LF in the repo, native in the working tree.
* text=auto eol=lf

# Generated / vendored — keep them out of diffs and language stats.
package-lock.json -diff linguist-generated
sourcemap.json -diff linguist-generated

# Roblox binaries
*.rbxl binary
*.rbxm binary
*.rbxlx text eol=lf
*.rbxmx text eol=lf

# Assets
*.png binary
*.jpg binary
*.ogg binary
*.mp3 binary
*.fbx binary
